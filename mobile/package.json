{
  "name": "@vlaina/mobile",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -p tsconfig.json --noEmit --pretty false && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "cap:sync": "pnpm build && cap sync",
